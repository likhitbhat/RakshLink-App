      this.safeZoneRepositoryImplProvider = DoubleCheck.provider(new SwitchingProvider<SafeZoneRepositoryImpl>(singletonCImpl, 9));
      this.blePendantRepositoryImplProvider = DoubleCheck.provider(new SwitchingProvider<BlePendantRepositoryImpl>(singletonCImpl, 10));
      this.emergencyContactRepositoryImplProvider = DoubleCheck.provider(new SwitchingProvider<EmergencyContactRepositoryImpl>(singletonCImpl, 11));
      this.nearbyPlacesRepositoryProvider = DoubleCheck.provider(new SwitchingProvider<NearbyPlacesRepository>(singletonCImpl, 12));
      this.fallDetectionManagerProvider = DoubleCheck.provider(new SwitchingProvider<FallDetectionManager>(singletonCImpl, 13));
      this.provideFusedLocationProviderClientProvider = DoubleCheck.provider(new SwitchingProvider<FusedLocationProviderClient>(singletonCImpl, 14));
    }

    @Override
