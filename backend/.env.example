# Twilio Credentials & Verify Service Configuration
# Keep this file template in git, but NEVER commit your real secrets!

PORT=3000

# Found at https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Created under Twilio Console -> Verify -> Services
# Ensure Code Length is set to 4 digits in Twilio Verify Console
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
